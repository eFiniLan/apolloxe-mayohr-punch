name = "apolloxe-mayohr-punch"
main = "src/index.ts"
compatibility_date = "2024-12-30"
workers_dev = false             # cron-only Worker → no public *.workers.dev URL

# Copy this file to `wrangler.toml` and fill in your own values, then deploy.
# `wrangler.toml` is gitignored so your real office id / coords / login stay
# out of the repo. MAYO_PASSWORD is never here — set it with:
#   npx wrangler secret put MAYO_PASSWORD

# A single Durable Object ("PunchDay") owns the schedule. Its SQLite storage holds
# the login cookie, calendar cache, and today's plan; its alarm() is a precise
# timer that fires exactly at each randomized punch time. No KV / Workflow needed.
[[durable_objects.bindings]]
name = "PUNCH_DAY"
class_name = "PunchDay"

# SQLite-backed DO (required for the free plan + alarms).
[[migrations]]
tag = "v1"
new_sqlite_classes = ["PunchDay"]

# Cron is only a daily BACKSTOP (UTC): 16:05 UTC = 00:05 Taipei. It pokes the DO to
# make sure today is planned + armed; the DO otherwise re-arms its own alarm
# (in → out → tomorrow), so the real work is alarm-driven, not cron-driven.
[triggers]
crons = ["5 16 * * *"]

# Config. Optional tuning vars (jitter, early/late minutes, reaction buffer,
# RESPECT_LEAVE) have sane code defaults — see the README's Configuration table to
# override them. Only MAYO_PASSWORD is a secret (`npx wrangler secret put`); the
# username and location live here. Swap these for your own office.
[vars]
TIMEZONE = "Asia/Taipei"
DRY_RUN = "true"                # "true" = run the flow but never actually punch (dry-run)

MAYO_USERNAME = "you@company.com"
PUNCH_LATITUDE = "25.0500000"                              # your office's real coordinates
PUNCH_LONGITUDE = "121.5500000"
PUNCHES_LOCATION_ID = "00000000-0000-0000-0000-000000000000"  # `npm run config set location` to find it

# Timing knobs (optional — shown at their code defaults; uncomment to change).
# Clock-in lands BEFORE shiftStart, clock-out AFTER shiftEnd, so "in early / out
# late" (and your 9h+ span) is guaranteed by construction — nothing is computed.
#   before shiftStart = REACTION_BUFFER_MIN + random(EARLY_IN_MIN..EARLY_IN_MAX)  (min 10)
#   after  shiftEnd   =                       random(LATE_OUT_MIN..LATE_OUT_MAX)
# REACTION_BUFFER_MIN = "10"     # guaranteed minutes before the shift (failure headroom)
# PUNCH_EARLY_IN_MIN  = "1"      # extra random minutes early — low end
# PUNCH_EARLY_IN_MAX  = "15"     #                            — high end
# PUNCH_LATE_OUT_MIN  = "1"      # random minutes late for clock-out — low end
# PUNCH_LATE_OUT_MAX  = "15"     #                                   — high end
# GPS_JITTER_METERS   = "12"     # random position wobble per punch, in metres
