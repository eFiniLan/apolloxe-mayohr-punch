name = "apolloxe-mayohr-punch"
main = "src/index.ts"
compatibility_date = "2024-12-30"

# Copy this file to `wrangler.toml` and fill in your own values, then deploy.
# `wrangler.toml` is gitignored so your real office id / coords / login stay
# out of the repo. MAYO_PASSWORD is never here — set it with:
#   npx wrangler secret put MAYO_PASSWORD

# Stateless — no KV. Idempotency comes from the server (already_done / cooldown).

# Optional: cache the login cookie + calendar across fires (≈1 login / 9 days
# instead of ~48/day). Without this the Worker is stateless (server idempotency).
#   npx wrangler kv namespace create APOLLO_KV
# then uncomment and paste the printed id:
# [[kv_namespaces]]
# binding = "APOLLO_KV"
# id = "<id>"

# Cron is UTC; Taiwan = UTC+8. Fires EVERY day (not just Mon–Fri) so makeup
# workdays (補班) on weekends still run — the calendar's isWorkday decides whether
# to actually punch, so weekends/holidays self-skip after one cheap check. Each
# fire attempts a punch only once it's past the randomized target time.
#   00:00–01:55 UTC = 08:00–09:55 Taipei  → clock-in
#   10:00–11:55 UTC = 18:00–19:55 Taipei  → clock-out
# (Aligns with default shift 09:30/18:30 + early-in/late-out jitter. If your shift
#  is much earlier/later, widen these UTC windows to cover it.)
[triggers]
crons = ["*/5 0-1 * * *", "*/5 10-11 * * *"]

# Config. Optional tuning vars (jitter, early/late minutes, reaction buffer,
# RESPECT_LEAVE) have sane code defaults — see the README's Configuration table to
# override them. Only MAYO_PASSWORD is a secret (`npx wrangler secret put`); the
# username and location live here. Swap these for your own office.
[vars]
TIMEZONE = "Asia/Taipei"
DRY_RUN = "true"                # "true" = run the flow but never actually punch (dry-run)

MAYO_USERNAME = "you@company.com"
PUNCH_LATITUDE = "25.0500000"                              # your office's real coordinates
PUNCH_LONGITUDE = "121.5500000"
PUNCHES_LOCATION_ID = "00000000-0000-0000-0000-000000000000"  # `npm run config set location` to find it
